DATABASE_BACKEND=sqlite
DATABASE_URL=
# 로컬 테스트용 활성 SQLite 경로. 기존 DB를 보존하려면 별도 파일을 지정하세요.
ANNUAL_STATISTICS_DB_PATH=backend/app/db/annual_statistics_test.sqlite
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_BYTES=104857600
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Railway에서는 DATABASE_BACKEND=postgres와 DATABASE_URL을 함께 설정하세요.
# Preview deployments can use a regex, but production should prefer exact origins.
# ALLOWED_ORIGIN_REGEX=https://.*\\.vercel\\.app
ALLOWED_ORIGIN_REGEX=

# auto: BizRouter 키가 있으면 BizRouter, 없으면 OpenAI
# ollama: 이 PC의 Ollama 로컬 모델 사용(인터넷·API 키 불필요). 아래 Ollama 항목 참고.
LLM_PROVIDER=auto
LLM_REVIEW_ENABLED=0
LLM_REVIEW_BATCH_SIZE=10
LLM_REVIEW_CONCURRENCY=3
LLM_REVIEW_LIMIT=
LLM_REVIEW_TIMEOUT=90
LLM_REVIEW_SLEEP=0.2
# Optional provider/model prices used only for llm_usage_events cost estimates.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# New/changed table profile drafting (stored once and reused by structure signature)
PROFILE_LLM_ENABLED=0
PROFILE_LLM_MODEL=gpt-5-mini

# 웹에서 연보를 업로드할 때 언어 LLM 검수까지 자동 실행합니다.
# 비용이 발생하므로 운영 환경에서 명시적으로 켜세요.
AUTO_IMPORT_INCLUDE_LLM=0

# Upload durability. Local development and one-process Railway can use local.
# A separate worker should use shared S3/R2 storage or a shared mounted volume.
SOURCE_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# inprocess: FastAPI background task, worker: persisted queue consumed by report_worker
JOB_EXECUTOR_BACKEND=inprocess
JOB_LEASE_SECONDS=300

# Original upload retention. Set 0 to keep files indefinitely.
COMPLETED_SOURCE_RETENTION_DAYS=365
FAILED_SOURCE_RETENTION_DAYS=90

# BizRouter (selected automatically when this key exists)
BIZROUTER_API_KEY=
BIZROUTER_MODEL=openai/gpt-5-mini
BIZROUTER_BASE_URL=https://api.bizrouter.ai/v1

# Direct OpenAI fallback
OPENAI_API_KEY=
OPENAI_LLM_REVIEW_ENABLED=0
OPENAI_TRANSLATION_MODEL=gpt-5.4-mini
OPENAI_LLM_REVIEW_BATCH_SIZE=10
OPENAI_LLM_REVIEW_LIMIT=
OPENAI_LLM_REVIEW_TIMEOUT=90
OPENAI_LLM_REVIEW_SLEEP=0.2

# Ollama 로컬 모델 (LLM_PROVIDER=ollama일 때 사용, 인터넷 없이 동작)
# 로컬 모델은 느리므로 LLM_REVIEW_TIMEOUT=600, LLM_REVIEW_CONCURRENCY=1 정도를 권장합니다.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder:30b
# 모델에 한 번에 넣는 최대 토큰 수. 묶음 검수 프롬프트가 잘리지 않도록 넉넉히 둡니다.
OLLAMA_NUM_CTX=32768
